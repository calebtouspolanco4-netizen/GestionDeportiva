@model List<GestionDeportiva.Models.Escenario>
@{
    ViewData["Title"] = "Escenarios";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h1 class="page-title">Escenarios</h1>
        <p class="page-subtitle">Administra tus canchas deportivas</p>
    </div>
    <div class="page-header-actions">
        <div class="btn-icon active" onclick="setView('grid')" id="btnGrid" title="Vista cuadrícula">
            <i class="fa-solid fa-table-cells-large"></i>
        </div>
        <div class="btn-icon" onclick="setView('list')" id="btnList" title="Vista lista">
            <i class="fa-solid fa-list"></i>
        </div>
        <button class="btn-primary" onclick="abrirModal(0)">
            <i class="fa-solid fa-plus"></i> Nuevo escenario
        </button>
    </div>
</div>

<!-- ESCENARIOS GRID -->
<div class="escenarios-grid" id="escenariosGrid">
    @foreach (var e in Model)
    {
        var estadoClass = e.Estado?.Nombre switch {
            "Disponible"    => "badge-green",
            "Mantenimiento" => "badge-red",
            "Ocupado"       => "badge-orange",
            _               => "badge-gray"
        };

        <div class="esc-card">
            @if (!string.IsNullOrWhiteSpace(e.UrlImagen))
            {
                <img src="@e.UrlImagen" alt="@e.Nombre" class="esc-img" />
            }
            else
            {
                <div class="esc-placeholder">
                    <i class="fa-solid fa-futbol"></i>
                </div>
            }
            <div class="esc-body">
                <div class="esc-title-row">
                    <span class="esc-name">@e.Nombre</span>
                    <div class="dropdown" style="position:relative;">
                        <button class="menu-btn" onclick="toggleMenu(this)" title="Opciones">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <div class="ctx-menu" style="display:none;position:absolute;right:0;top:100%;background:var(--bg-secondary);border:1px solid var(--border);border-radius:8px;min-width:140px;z-index:50;padding:4px 0;">
                            <button class="ctx-item" onclick="abrirModal(@e.EscenarioId)">
                                <i class="fa-solid fa-pen-to-square"></i> Editar
                            </button>
                            <button class="ctx-item ctx-danger" onclick="confirmarEliminar(@e.EscenarioId,'@e.Nombre')">
                                <i class="fa-solid fa-trash-can"></i> Eliminar
                            </button>
                        </div>
                    </div>
                </div>
                <div class="esc-sport">@(e.Deporte?.Nombre ?? "Sin deporte")</div>
                <div class="esc-footer">
                    <div class="esc-meta">
                        <div class="esc-meta-item">
                            <i class="fa-solid fa-users"></i>
                            <span>@(e.CapacidadPersonas ?? 0)</span>
                        </div>
                        <div class="esc-meta-item">
                            <i class="fa-solid fa-dollar-sign"></i>
                            <span>@e.PrecioPorHora.ToString("N0")/h</span>
                        </div>
                    </div>
                    <span class="badge @estadoClass">@(e.Estado?.Nombre ?? "—")</span>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--text-secondary);">
            <i class="fa-solid fa-circle-xmark" style="font-size:40px;display:block;margin-bottom:12px;"></i>
            No hay escenarios registrados. ¡Crea el primero!
        </div>
    }
</div>

<!-- MODAL -->
<div id="modalEscenario" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;">
    <div style="background:var(--bg-card);border-radius:14px;border:1px solid var(--border);width:100%;max-width:520px;max-height:90vh;overflow-y:auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border-bottom:1px solid var(--border);">
            <h3 style="font-size:16px;font-weight:600;" id="modalTitle">Nuevo escenario</h3>
            <button onclick="cerrarModal()" style="background:none;border:none;color:var(--text-secondary);font-size:18px;cursor:pointer;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div id="modalBody" style="padding:24px;">
            <div style="text-align:center;padding:30px;color:var(--text-secondary);">
                <i class="fa-solid fa-spinner fa-spin"></i>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
.ctx-item {
    display:flex;align-items:center;gap:8px;
    width:100%;padding:9px 14px;
    background:none;border:none;
    color:var(--text-secondary);font-size:13px;font-family:inherit;
    cursor:pointer;text-align:left;transition:background 0.15s,color 0.15s;
}
.ctx-item:hover { background:rgba(255,255,255,0.05);color:var(--text); }
.ctx-item.ctx-danger:hover { color:var(--red); }
</style>
<script>
function setView(v) {
    const grid = document.getElementById('escenariosGrid');
    const btnGrid = document.getElementById('btnGrid');
    const btnList = document.getElementById('btnList');
    if (v === 'list') {
        grid.style.gridTemplateColumns = '1fr';
        btnGrid.classList.remove('active'); btnList.classList.add('active');
    } else {
        grid.style.gridTemplateColumns = '';
        btnList.classList.remove('active'); btnGrid.classList.add('active');
    }
}
function toggleMenu(btn) {
    document.querySelectorAll('.ctx-menu').forEach(m => {
        if (m !== btn.nextElementSibling) m.style.display = 'none';
    });
    const menu = btn.nextElementSibling;
    menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
}
document.addEventListener('click', e => {
    if (!e.target.closest('.dropdown')) {
        document.querySelectorAll('.ctx-menu').forEach(m => m.style.display = 'none');
    }
});

function abrirModal(id) {
    const modal = document.getElementById('modalEscenario');
    const title = document.getElementById('modalTitle');
    const body  = document.getElementById('modalBody');
    title.textContent = id ? 'Editar escenario' : 'Nuevo escenario';
    modal.style.display = 'flex';
    const url = id ? `/Escenarios/Editar/${id}` : '/Escenarios/Crear';
    fetch(url).then(r => r.text()).then(html => body.innerHTML = html);
}
function cerrarModal() {
    document.getElementById('modalEscenario').style.display = 'none';
}

async function confirmarEliminar(id, nombre) {
    const result = await Swal.fire({
        title: `¿Eliminar ${nombre}?`,
        text: 'Esta acción no se puede deshacer.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#374151',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar',
        background: '#252830', color: '#fff'
    });
    if (!result.isConfirmed) return;
    const form = document.createElement('form');
    form.method = 'POST'; form.action = `/Escenarios/Eliminar/${id}`;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}">`;
    document.body.appendChild(form); form.submit();
}
</script>
}
