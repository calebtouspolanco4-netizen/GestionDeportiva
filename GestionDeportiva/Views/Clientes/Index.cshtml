@model GestionDeportiva.ViewModels.ClientesIndexViewModel
@{
    ViewData["Title"] = "Clientes";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h1 class="page-title">Clientes</h1>
        <p class="page-subtitle">Gestiona la base de clientes</p>
    </div>
    <button class="btn-primary" onclick="abrirModalCliente()">
        <i class="fa-solid fa-plus"></i> Nuevo cliente
    </button>
</div>

<!-- SEARCH BAR -->
<form method="get" asp-controller="Clientes" asp-action="Index">
    <div class="search-row">
        <div class="search-wrap">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input class="search-input" type="text" name="busqueda"
                   value="@Model.Busqueda" placeholder="Buscar cliente..." />
        </div>
        <input type="hidden" name="porPagina" value="@Model.PorPagina" />
        <button type="submit" class="btn-secondary">
            <i class="fa-solid fa-filter"></i> Filtros
        </button>
    </div>
</form>

<!-- TABLE -->
<div class="table-wrap">
    <table class="dark-table">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Contacto</th>
                <th style="text-align:center;">WhatsApp</th>
                <th style="text-align:center;">Reservas</th>
                <th>Total gastado</th>
                <th>Última reserva</th>
                <th style="text-align:center;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Clientes.Any())
            {
                <tr>
                    <td colspan="7" style="text-align:center;padding:40px;color:var(--text-secondary);">
                        No se encontraron clientes
                    </td>
                </tr>
            }
            @foreach (var c in Model.Clientes)
            {
                <tr>
                    <td style="font-weight:500;">@c.Cliente</td>
                    <td style="color:var(--text-secondary);">@c.Contacto</td>
                    <td style="text-align:center;">
                        @if (c.WhatsApp == true)
                        {
                            <i class="fa-brands fa-whatsapp" style="color:#25d366;font-size:18px;" title="Tiene WhatsApp"></i>
                        }
                        else
                        {
                            <span style="color:var(--text-muted);">—</span>
                        }
                    </td>
                    <td style="text-align:center;font-weight:600;">@(c.TotalReservas ?? 0)</td>
                    <td style="font-weight:600;color:var(--green);">$@c.TotalGastado.ToString("N0")</td>
                    <td style="color:var(--text-secondary);">
                        @(c.UltimaReserva.HasValue ? c.UltimaReserva.Value.ToString("dd/MM/yyyy") : "—")
                    </td>
                    <td style="text-align:center;">
                        <button class="btn-icon" onclick="confirmarEliminarCliente(@c.ClienteId,'@c.Cliente')"
                                title="Eliminar">
                            <i class="fa-solid fa-trash-can" style="color:var(--red);font-size:13px;"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    <div class="pagination-bar">
        <div class="pag-btns">
            @{
                var prev = Model.PaginaActual - 1;
                var next = Model.PaginaActual + 1;
            }
            <a class="pag-btn @(Model.PaginaActual == 1 ? "disabled" : "")"
               href="?busqueda=@Model.Busqueda&pagina=@prev&porPagina=@Model.PorPagina"
               @(Model.PaginaActual == 1 ? "aria-disabled=true" : "")>
                <i class="fa-solid fa-chevron-left" style="font-size:11px;"></i>
            </a>

            @for (int p = 1; p <= Model.TotalPaginas; p++)
            {
                if (p == 1 || p == Model.TotalPaginas || Math.Abs(p - Model.PaginaActual) <= 1)
                {
                    <a class="pag-btn @(p == Model.PaginaActual ? "active" : "")"
                       href="?busqueda=@Model.Busqueda&pagina=@p&porPagina=@Model.PorPagina">@p</a>
                }
                else if (Math.Abs(p - Model.PaginaActual) == 2)
                {
                    <span class="pag-btn" style="cursor:default;pointer-events:none;">…</span>
                }
            }

            <a class="pag-btn @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")"
               href="?busqueda=@Model.Busqueda&pagina=@next&porPagina=@Model.PorPagina"
               @(Model.PaginaActual == Model.TotalPaginas ? "aria-disabled=true" : "")>
                <i class="fa-solid fa-chevron-right" style="font-size:11px;"></i>
            </a>
        </div>

        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:12px;color:var(--text-secondary);">Mostrando @Model.Clientes.Count de @Model.TotalRegistros</span>
            <form method="get" asp-controller="Clientes" asp-action="Index" style="display:inline;">
                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                <input type="hidden" name="pagina" value="1" />
                <select name="porPagina" class="select-dark" onchange="this.form.submit()">
                    @foreach (var n in new[] { 6, 10, 20, 50 })
                    {
                        if (Model.PorPagina == n)
                        {
                            <option value="@n" selected>@n por página</option>
                        }
                        else
                        {
                            <option value="@n">@n por página</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>
</div>

<!-- MODAL NUEVO CLIENTE -->
<div id="modalCliente" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.65);align-items:center;justify-content:center;">
    <div style="background:var(--bg-card);border-radius:14px;border:1px solid var(--border);width:100%;max-width:460px;">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid var(--border);">
            <h3 style="font-size:16px;font-weight:600;">Nuevo cliente</h3>
            <button onclick="cerrarModalCliente()" style="background:none;border:none;color:var(--text-secondary);font-size:18px;cursor:pointer;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <form method="post" asp-controller="Clientes" asp-action="Crear" style="padding:22px;">
            @Html.AntiForgeryToken()
            <div style="margin-bottom:14px;">
                <label style="font-size:12px;color:var(--text-secondary);display:block;margin-bottom:5px;">Nombre completo *</label>
                <input name="NombreCompleto" required class="search-input" style="padding-left:14px;" placeholder="Juan Pérez" />
            </div>
            <div style="margin-bottom:14px;">
                <label style="font-size:12px;color:var(--text-secondary);display:block;margin-bottom:5px;">Teléfono *</label>
                <input name="Telefono" required class="search-input" style="padding-left:14px;" placeholder="300 123 4567" />
            </div>
            <div style="margin-bottom:20px;">
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;">
                    <input type="checkbox" name="TieneWhatsapp" value="true" checked style="accent-color:var(--accent);" />
                    Tiene WhatsApp
                </label>
            </div>
            <div style="display:flex;gap:10px;">
                <button type="button" onclick="cerrarModalCliente()" class="btn-secondary" style="flex:1;">Cancelar</button>
                <button type="submit" class="btn-primary" style="flex:1;">Guardar cliente</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function abrirModalCliente() {
    document.getElementById('modalCliente').style.display = 'flex';
}
function cerrarModalCliente() {
    document.getElementById('modalCliente').style.display = 'none';
}

async function confirmarEliminarCliente(id, nombre) {
    const r = await Swal.fire({
        title: `¿Eliminar a ${nombre}?`,
        text: 'El cliente será desactivado.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#374151',
        confirmButtonText: 'Eliminar',
        cancelButtonText: 'Cancelar',
        background: '#252830', color: '#fff'
    });
    if (!r.isConfirmed) return;
    const form = document.createElement('form');
    form.method = 'POST'; form.action = `/Clientes/Eliminar/${id}`;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    form.innerHTML = `<input type="hidden" name="__RequestVerificationToken" value="${token}">`;
    document.body.appendChild(form); form.submit();
}
</script>
}
