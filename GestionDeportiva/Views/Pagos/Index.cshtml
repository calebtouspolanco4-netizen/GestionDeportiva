@model GestionDeportiva.ViewModels.PagosIndexViewModel
@{
    ViewData["Title"] = "Pagos";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h1 class="page-title">Pagos y Recaudos</h1>
        <p class="page-subtitle">Control de ingresos, comprobantes y cuentas por cobrar</p>
    </div>
    <div class="page-header-actions">
        <button class="btn-primary" onclick="abrirModalRegistrarPago()">
            <i class="fa-solid fa-plus"></i> Registrar pago
        </button>
    </div>
</div>

<!-- METRIC CARDS -->
<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-header">
            <span class="metric-label">Recaudo del Mes</span>
            <div class="metric-icon mi-green"><i class="fa-solid fa-sack-dollar"></i></div>
        </div>
        <div class="metric-value" style="color:var(--green);font-size:24px;">$@Model.TotalRecaudadoMes.ToString("N0")</div>
        <div class="metric-change change-up">
            <i class="fa-solid fa-arrow-up"></i> Ingresos confirmados este mes
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-header">
            <span class="metric-label">Recaudo de Hoy</span>
            <div class="metric-icon mi-yellow"><i class="fa-solid fa-calendar-day"></i></div>
        </div>
        <div class="metric-value" style="font-size:24px;">$@Model.TotalRecaudadoHoy.ToString("N0")</div>
        <div class="metric-change change-neutral">
            <span>Caja del día</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-header">
            <span class="metric-label">Transacciones</span>
            <div class="metric-icon mi-blue"><i class="fa-solid fa-receipt"></i></div>
        </div>
        <div class="metric-value">@Model.TotalTransaccionesMes</div>
        <div class="metric-change change-neutral">
            <span>Pagos registrados este mes</span>
        </div>
    </div>
    <div class="metric-card">
        <div class="metric-header">
            <span class="metric-label">Cartera Pendiente</span>
            <div class="metric-icon mi-purple"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        </div>
        <div class="metric-value" style="color:var(--orange);font-size:24px;">$@Model.SaldoTotalPendiente.ToString("N0")</div>
        <div class="metric-change change-down">
            <span>Saldos por cobrar</span>
        </div>
    </div>
</div>

<!-- SEARCH & FILTERS -->
<form method="get" asp-controller="Pagos" asp-action="Index" style="margin-bottom:20px;">
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <div class="search-wrap" style="flex:1;min-width:200px;">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input class="search-input" type="text" name="busqueda"
                   value="@Model.Busqueda" placeholder="Buscar por cliente, comprobante o ref..." />
        </div>

        <div style="width:170px;">
            <select name="metodoPagoId" class="form-control-dark" style="padding:9px 12px;">
                <option value="">Todos los métodos</option>
                @foreach (var m in Model.MetodosPago)
                {
                    if (Model.MetodoPagoId == m.MetodoPagoId)
                    {
                        <option value="@m.MetodoPagoId" selected>@m.Nombre</option>
                    }
                    else
                    {
                        <option value="@m.MetodoPagoId">@m.Nombre</option>
                    }
                }
            </select>
        </div>

        <div style="display:flex;align-items:center;gap:6px;">
            <span style="font-size:12px;color:var(--text-secondary);">Desde:</span>
            <input type="date" name="fechaDesde" value="@Model.FechaDesde" class="form-control-dark" style="padding:9px 10px;width:145px;" />
        </div>

        <div style="display:flex;align-items:center;gap:6px;">
            <span style="font-size:12px;color:var(--text-secondary);">Hasta:</span>
            <input type="date" name="fechaHasta" value="@Model.FechaHasta" class="form-control-dark" style="padding:9px 10px;width:145px;" />
        </div>

        <input type="hidden" name="porPagina" value="@Model.PorPagina" />

        <button type="submit" class="btn-primary" style="padding:10px 16px;">
            <i class="fa-solid fa-filter"></i> Filtrar
        </button>

        @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.MetodoPagoId.HasValue || !string.IsNullOrWhiteSpace(Model.FechaDesde) || !string.IsNullOrWhiteSpace(Model.FechaHasta))
        {
            <a asp-controller="Pagos" asp-action="Index" class="btn-secondary" style="padding:10px 14px;" title="Limpiar filtros">
                <i class="fa-solid fa-xmark"></i> Limpiar
            </a>
        }
    </div>
</form>

<!-- PAGOS TABLE -->
<div class="table-wrap">
    <table class="dark-table">
        <thead>
            <tr>
                <th style="width:90px;">Recibo #</th>
                <th>Fecha y Hora</th>
                <th>Cliente</th>
                <th>Cancha / Reserva</th>
                <th>Método de Pago</th>
                <th>Referencia</th>
                <th style="text-align:right;">Monto Pagado</th>
                <th style="text-align:center;width:110px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Pagos.Any())
            {
                <tr>
                    <td colspan="8" style="text-align:center;padding:50px;color:var(--text-secondary);">
                        <i class="fa-solid fa-receipt" style="font-size:36px;display:block;margin-bottom:10px;color:var(--text-muted);"></i>
                        No se encontraron registros de pago.
                    </td>
                </tr>
            }
            @foreach (var p in Model.Pagos)
            {
                var metodoIcon = p.MetodoPagoNombre.ToLower() switch
                {
                    var m when m.Contains("efectivo") => "fa-money-bill-wave",
                    var m when m.Contains("tarjeta") => "fa-credit-card",
                    var m when m.Contains("transferencia") => "fa-building-columns",
                    var m when m.Contains("nequi") || m.Contains("daviplata") => "fa-mobile-screen-button",
                    _ => "fa-wallet"
                };

                <tr>
                    <td style="font-weight:700;color:var(--accent);">
                        #PAG-@p.PagoId
                    </td>
                    <td>
                        <div style="font-weight:600;">@p.FechaPago.ToString("dd/MM/yyyy")</div>
                        <div style="font-size:11px;color:var(--text-secondary);">@p.FechaPago.ToString("hh:mm tt")</div>
                    </td>
                    <td>
                        <div style="font-weight:600;">@p.ClienteNombre</div>
                        <div style="font-size:12px;color:var(--text-secondary);">@p.ClienteTelefono</div>
                    </td>
                    <td>
                        <div style="font-weight:500;">@p.EscenarioNombre</div>
                        <div style="font-size:11px;color:var(--text-secondary);">
                            Reserva #@p.ReservaId · @p.FechaReserva.ToString("dd/MM") (@p.HoraInicio.ToString("HH:mm") - @p.HoraFin.ToString("HH:mm"))
                        </div>
                    </td>
                    <td>
                        <span class="badge badge-purple" style="display:inline-flex;align-items:center;gap:5px;">
                            <i class="fa-solid @metodoIcon"></i> @p.MetodoPagoNombre
                        </span>
                    </td>
                    <td style="color:var(--text-secondary);font-size:12px;">
                        @(string.IsNullOrWhiteSpace(p.ReferenciaTransaccion) ? "—" : p.ReferenciaTransaccion)
                    </td>
                    <td style="text-align:right;font-size:15px;font-weight:700;color:var(--green);">
                        $@p.Monto.ToString("N0")
                    </td>
                    <td style="text-align:center;">
                        <div style="display:inline-flex;gap:6px;align-items:center;">
                            <!-- Ver Comprobante -->
                            <button class="btn-icon" onclick="verComprobante(@p.PagoId)" title="Ver / Imprimir comprobante">
                                <i class="fa-solid fa-print"></i>
                            </button>
                            <!-- Anular pago -->
                            <button class="btn-icon" onclick="confirmarAnularPago(@p.PagoId, '@p.Monto.ToString("N0")')" title="Anular pago">
                                <i class="fa-solid fa-trash-can" style="color:var(--red);font-size:12px;"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    <div class="pagination-bar">
        <div class="pag-btns">
            @{
                var prev = Model.PaginaActual - 1;
                var next = Model.PaginaActual + 1;
            }
            <a class="pag-btn @(Model.PaginaActual == 1 ? "disabled" : "")"
               href="?busqueda=@Model.Busqueda&metodoPagoId=@Model.MetodoPagoId&fechaDesde=@Model.FechaDesde&fechaHasta=@Model.FechaHasta&pagina=@prev&porPagina=@Model.PorPagina"
               @(Model.PaginaActual == 1 ? "aria-disabled=true" : "")>
                <i class="fa-solid fa-chevron-left" style="font-size:11px;"></i>
            </a>

            @for (int pg = 1; pg <= Model.TotalPaginas; pg++)
            {
                if (pg == 1 || pg == Model.TotalPaginas || Math.Abs(pg - Model.PaginaActual) <= 1)
                {
                    <a class="pag-btn @(pg == Model.PaginaActual ? "active" : "")"
                       href="?busqueda=@Model.Busqueda&metodoPagoId=@Model.MetodoPagoId&fechaDesde=@Model.FechaDesde&fechaHasta=@Model.FechaHasta&pagina=@pg&porPagina=@Model.PorPagina">@pg</a>
                }
                else if (Math.Abs(pg - Model.PaginaActual) == 2)
                {
                    <span class="pag-btn" style="cursor:default;pointer-events:none;">…</span>
                }
            }

            <a class="pag-btn @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")"
               href="?busqueda=@Model.Busqueda&metodoPagoId=@Model.MetodoPagoId&fechaDesde=@Model.FechaDesde&fechaHasta=@Model.FechaHasta&pagina=@next&porPagina=@Model.PorPagina"
               @(Model.PaginaActual == Model.TotalPaginas ? "aria-disabled=true" : "")>
                <i class="fa-solid fa-chevron-right" style="font-size:11px;"></i>
            </a>
        </div>

        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:12px;color:var(--text-secondary);">Mostrando @Model.Pagos.Count de @Model.TotalRegistros pagos</span>
            <form method="get" asp-controller="Pagos" asp-action="Index" style="display:inline;">
                <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                <input type="hidden" name="metodoPagoId" value="@Model.MetodoPagoId" />
                <input type="hidden" name="fechaDesde" value="@Model.FechaDesde" />
                <input type="hidden" name="fechaHasta" value="@Model.FechaHasta" />
                <input type="hidden" name="pagina" value="1" />
                <select name="porPagina" class="select-dark" onchange="this.form.submit()">
                    @foreach (var n in new[] { 6, 10, 20, 50 })
                    {
                        if (Model.PorPagina == n)
                        {
                            <option value="@n" selected>@n por página</option>
                        }
                        else
                        {
                            <option value="@n">@n por página</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>
</div>

<!-- =============================================
     MODAL REGISTRAR PAGO
     ============================================= -->
<div id="modalRegistrarPago" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);align-items:center;justify-content:center;padding:16px;">
    <div style="background:var(--bg-card);border-radius:14px;border:1px solid var(--border);width:100%;max-width:520px;max-height:92vh;overflow-y:auto;box-shadow:0 12px 36px rgba(0,0,0,0.6);">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid var(--border);">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:36px;height:36px;border-radius:8px;background:rgba(34,197,94,0.15);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:16px;">
                    <i class="fa-solid fa-dollar-sign"></i>
                </div>
                <div>
                    <h3 style="font-size:16px;font-weight:700;">Registrar Pago o Abono</h3>
                    <div style="font-size:11px;color:var(--text-secondary);">Aplica el pago a una reserva existente</div>
                </div>
            </div>
            <button onclick="cerrarModalRegistrarPago()" style="background:none;border:none;color:var(--text-secondary);font-size:18px;cursor:pointer;">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="formRegistrarPago" onsubmit="guardarPago(event)" style="padding:22px 24px;">
            @Html.AntiForgeryToken()

            <!-- Selección de Reserva -->
            <div class="form-group">
                <label class="form-label">Reserva Pendiente *</label>
                <select id="pagoReservaId" name="ReservaId" required class="form-control-dark" onchange="seleccionarReserva(this)">
                    <option value="">-- Selecciona una reserva con saldo --</option>
                    @foreach (var res in Model.ReservasPendientes)
                    {
                        var sel = Model.PreseleccionarReservaId == res.ReservaId;
                        <option value="@res.ReservaId"
                                data-saldo="@res.SaldoPendiente"
                                data-total="@res.MontoTotal"
                                selected="@sel">
                            #@res.ReservaId — @res.ClienteNombre (@res.EscenarioNombre - @res.FechaReserva:dd/MM) [Debe: $@res.SaldoPendiente.ToString("N0")]
                        </option>
                    }
                </select>
                @if (!Model.ReservasPendientes.Any())
                {
                    <div style="font-size:12px;color:var(--green);margin-top:6px;">
                        <i class="fa-solid fa-circle-check"></i> Todas las reservas activas están completamente pagadas.
                    </div>
                }
            </div>

            <!-- Resumen de Saldo -->
            <div id="cajaInfoSaldo" style="background:rgba(255,255,255,0.02);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:16px;display:none;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:12px;color:var(--text-secondary);">Saldo pendiente de la reserva:</span>
                    <span id="txtSaldoPendiente" style="font-size:16px;font-weight:700;color:var(--orange);">$0</span>
                </div>
            </div>

            <!-- Monto -->
            <div class="form-group">
                <label class="form-label">Monto a Cobrar ($) *</label>
                <input type="number" id="pagoMonto" name="Monto" required min="1" class="form-control-dark" placeholder="Ej: 50000" />
            </div>

            <!-- Método de Pago -->
            <div class="form-group">
                <label class="form-label">Método de Pago *</label>
                <select id="pagoMetodoId" name="MetodoPagoId" required class="form-control-dark">
                    @foreach (var m in Model.MetodosPago)
                    {
                        <option value="@m.MetodoPagoId">@m.Nombre</option>
                    }
                </select>
            </div>

            <!-- Referencia -->
            <div class="form-group">
                <label class="form-label">Nro. de Aprobación / Referencia / Comprobante</label>
                <input type="text" name="ReferenciaTransaccion" class="form-control-dark" placeholder="Ej: Nequi M123456 / Voucher 9871" />
            </div>

            <!-- Botones -->
            <div style="display:flex;gap:12px;margin-top:22px;">
                <button type="button" onclick="cerrarModalRegistrarPago()" class="btn-secondary" style="flex:1;">
                    Cancelar
                </button>
                <button type="submit" id="btnSubmitPago" class="btn-primary" style="flex:1;justify-content:center;">
                    <i class="fa-solid fa-check"></i> Confirmar pago
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =============================================
     MODAL COMPROBANTE DE PAGO
     ============================================= -->
<div id="modalComprobante" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.75);align-items:center;justify-content:center;padding:16px;">
    <div style="width:100%;max-width:440px;">
        <!-- Card Comprobante Imprimible -->
        <div id="printableReceipt" class="receipt-box">
            <div class="receipt-header">
                <div style="font-size:24px;color:#f0b429;margin-bottom:4px;">
                    <i class="fa-solid fa-futbol"></i>
                </div>
                <div class="receipt-title" id="rcEstNombre">LA JUGADA</div>
                <div class="receipt-sub" id="rcEstSub">Canchas Sintéticas Deportivas</div>
                <div class="receipt-sub" id="rcEstContacto">Tel: 601 234 5678</div>
                <div style="margin-top:10px;display:inline-block;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:4px 10px;font-size:12px;font-weight:700;color:#0f172a;" id="rcNroComprobante">
                    RECIBO DE CAJA #PAG-0
                </div>
            </div>

            <div class="receipt-row">
                <span class="receipt-label">Fecha y Hora:</span>
                <span class="receipt-val" id="rcFecha">--/--/----</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Cliente:</span>
                <span class="receipt-val" id="rcCliente">---</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Cancha:</span>
                <span class="receipt-val" id="rcCancha">---</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Horario:</span>
                <span class="receipt-val" id="rcHorario">--:-- a --:--</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Método de pago:</span>
                <span class="receipt-val" id="rcMetodo">---</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">Referencia / Comprobante:</span>
                <span class="receipt-val" id="rcRef">---</span>
            </div>

            <div class="receipt-row total">
                <span>MONTO PAGADO:</span>
                <span style="color:#16a34a;" id="rcMonto">$0</span>
            </div>

            <div class="receipt-row" style="border-top:none;">
                <span class="receipt-label">Valor total de reserva:</span>
                <span class="receipt-val" id="rcTotalReserva">$0</span>
            </div>
            <div class="receipt-row" style="border-top:none;">
                <span class="receipt-label">Saldo restante:</span>
                <span class="receipt-val" id="rcSaldoRestante" style="color:#dc2626;">$0</span>
            </div>

            <div class="receipt-footer">
                <div>¡Gracias por su pago y preferencia!</div>
                <div>Este documento es un comprobante de abono / pago de servicio deportivo.</div>
            </div>
        </div>

        <!-- Botones de Acción (no imprimibles) -->
        <div style="display:flex;gap:10px;margin-top:14px;">
            <button type="button" onclick="cerrarModalComprobante()" class="btn-secondary" style="flex:1;">
                Cerrar
            </button>
            <button type="button" onclick="window.print()" class="btn-primary" style="flex:1;justify-content:center;">
                <i class="fa-solid fa-print"></i> Imprimir comprobante
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    // Si viene con bandera de abrir modal
    const abrir = '@Model.AbrirModalRegistrar'.toLowerCase() === 'true';
    if (abrir) {
        abrirModalRegistrarPago();
    }
});

function abrirModalRegistrarPago() {
    document.getElementById('modalRegistrarPago').style.display = 'flex';
    const sel = document.getElementById('pagoReservaId');
    if (sel && sel.selectedIndex > 0) {
        seleccionarReserva(sel);
    }
}

function cerrarModalRegistrarPago() {
    document.getElementById('modalRegistrarPago').style.display = 'none';
}

function seleccionarReserva(select) {
    const opt = select.options[select.selectedIndex];
    const saldo = parseFloat(opt?.getAttribute('data-saldo')) || 0;
    const info = document.getElementById('cajaInfoSaldo');
    const txtSaldo = document.getElementById('txtSaldoPendiente');
    const inputMonto = document.getElementById('pagoMonto');

    if (opt && opt.value) {
        info.style.display = 'block';
        txtSaldo.textContent = `$${saldo.toLocaleString('es-CO')}`;
        inputMonto.value = saldo;
    } else {
        info.style.display = 'none';
        inputMonto.value = '';
    }
}

async function guardarPago(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitPago');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registrando...';

    const form = document.getElementById('formRegistrarPago');
    const formData = new FormData(form);

    try {
        const res = await fetch('/Pagos/Registrar', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();

        if (data.ok) {
            cerrarModalRegistrarPago();
            await Swal.fire({
                title: '¡Pago Registrado!',
                text: data.msg,
                icon: 'success',
                confirmButtonColor: '#22c55e',
                background: '#252830', color: '#fff'
            });
            // Abrir comprobante
            verComprobante(data.pagoId);
        } else {
            Swal.fire({
                title: 'Atención',
                text: data.msg,
                icon: 'warning',
                confirmButtonColor: '#f0b429',
                background: '#252830', color: '#fff'
            });
        }
    } catch (err) {
        Swal.fire({
            title: 'Error',
            text: 'Ocurrió un error al procesar el pago.',
            icon: 'error',
            confirmButtonColor: '#ef4444',
            background: '#252830', color: '#fff'
        });
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Confirmar pago';
    }
}

async function verComprobante(pagoId) {
    try {
        const res = await fetch(`/Pagos/Comprobante/${pagoId}`);
        const d = await res.json();

        document.getElementById('rcNroComprobante').textContent = `RECIBO DE CAJA #PAG-${d.pagoId}`;
        document.getElementById('rcEstNombre').textContent = d.establecimientoNombre.toUpperCase();
        document.getElementById('rcEstContacto').textContent = `${d.establecimientoDireccion} · Tel: ${d.establecimientoTelefono}`;
        document.getElementById('rcFecha').textContent = d.fechaPago;
        document.getElementById('rcCliente').textContent = `${d.clienteNombre} (${d.clienteTelefono})`;
        document.getElementById('rcCancha').textContent = d.escenarioNombre;
        document.getElementById('rcHorario').textContent = `${d.fechaReserva} (${d.horario})`;
        document.getElementById('rcMetodo').textContent = d.metodoPago;
        document.getElementById('rcRef').textContent = d.referencia;
        document.getElementById('rcMonto').textContent = `$${d.montoPagado.toLocaleString('es-CO')}`;
        document.getElementById('rcTotalReserva').textContent = `$${d.montoTotalReserva.toLocaleString('es-CO')}`;
        document.getElementById('rcSaldoRestante').textContent = `$${d.saldoRestante.toLocaleString('es-CO')}`;

        document.getElementById('modalComprobante').style.display = 'flex';
    } catch (err) {
        Swal.fire({
            title: 'Error',
            text: 'No se pudo generar el comprobante.',
            icon: 'error',
            background: '#252830', color: '#fff'
        });
    }
}

function cerrarModalComprobante() {
    document.getElementById('modalComprobante').style.display = 'none';
    location.reload();
}

async function confirmarAnularPago(id, monto) {
    const res = await Swal.fire({
        title: `¿Anular Pago por $${monto}?`,
        text: 'El monto se descontará de los pagos de la reserva y el saldo pendiente aumentará.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#374151',
        confirmButtonText: 'Sí, anular',
        cancelButtonText: 'Cancelar',
        background: '#252830', color: '#fff'
    });

    if (!res.isConfirmed) return;

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const formData = new FormData();
    formData.append('id', id);
    formData.append('__RequestVerificationToken', token);

    const resp = await fetch(`/Pagos/Eliminar/${id}`, {
        method: 'POST',
        body: formData
    });
    const data = await resp.json();

    await Swal.fire({
        title: data.ok ? 'Anulado' : 'Aviso',
        text: data.msg,
        icon: data.ok ? 'success' : 'error',
        confirmButtonColor: '#22c55e',
        background: '#252830', color: '#fff'
    });

    location.reload();
}
</script>
}

